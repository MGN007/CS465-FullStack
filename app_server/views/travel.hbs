<div id="contents">
	<div class="box">
		<div>
			<div class="body">
				<h1>Travel</h1>

				{{!-- Loop through the trips data passed from the controller --}}
				<ul id="sites">
					{{#each trips}}
					<li>
						{{!-- Display the trip image --}}
						<a href="/travel"><img src="/images/{{this.image}}" alt="Img"></a>

						{{!-- Display the trip name --}}
						<h2><a href="/travel">{{this.name}}</a></h2>

						{{!-- Display the trip description from the JSON file --}}
						{{{this.description}}}
					</li>
					{{/each}}
				</ul>
			</div>
		</div>
	</div>
</div>